lemma triple_residual_cover_0_50 : ∀ c : Fin 75,
    TripleResidual 0 50 c → ∃ w ∈ tripleResiduals,
      w.kind = 0 ∧ w.b = 50 ∧ w.c = c := by decide +kernel

