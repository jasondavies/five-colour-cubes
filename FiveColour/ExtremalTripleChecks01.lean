lemma triple_residual_cover_0_25 : ∀ c : Fin 75,
    TripleResidual 0 25 c → ∃ w ∈ tripleResiduals,
      w.kind = 0 ∧ w.b = 25 ∧ w.c = c := by decide +kernel

