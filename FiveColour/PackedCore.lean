def place (i : Nat) : Nat := places[i]!
def middle : Nat := 5783580587434429433751774908835077864143572811472030770551607154406796964579734527807229790198231033796398828540485624991996511981318944660739180725221265625970270395356602614932750484465056824778255072212653118189025099776
def digit (v i : Nat) : Nat := v / place i % base
def encode (f : Fin 75 → Nat) : Nat :=
  (List.finRange 75).foldl (fun acc i => acc + f i * place i.val) 0
structure Cut where
  mask : Nat
  weight : Nat
  rhs : Nat
structure Box where
  lower : Nat
  upper : Nat
structure Summary where
  common : Nat
  united : Nat
  slack : Nat
  gap : Nat
/-- Subset-sum implementation. `packed_subset_sum` and `mass_eq` prove
its meaning for bounded vectors and calibrated cuts. -/
def mass (v : Nat) (c : Cut) : Nat := v * c.weight / middle % base
def allWeight : Nat := 5789234136395753411692881238169227500374407193496930116368373143805044077937094972115936759690115912617314174413936735084852813557058259367152415505988832845545998909917068502141873407714778287950081323505138605108075955201
def total (v : Nat) : Nat := v * allWeight / middle % base

def summarize (b : Box) (goal : Nat) (cs : List Cut) : Option Summary :=
  let high := total b.upper
  cs.foldl (fun state c =>
    let l := mass b.lower c
    let outside := high - mass b.upper c
    if l ≤ c.rhs && goal ≤ c.rhs + outside then
      let s := { common := c.mask, united := c.mask,
                 slack := c.rhs - l, gap := c.rhs + outside - goal : Summary }
      some (match state with
        | none => s
        | some t => { common := t.common &&& s.common, united := t.united ||| s.united,
                      slack := max t.slack s.slack, gap := max t.gap s.gap })
    else state) none

def applySummary (b : Box) (s : Summary) : Box where
  lower := encode fun i =>
    let l := digit b.lower i.val
    if s.united.testBit i.val then l else max l (digit b.upper i.val - s.gap)
  upper := encode fun i =>
    let h := digit b.upper i.val
    if s.common.testBit i.val then min h (digit b.lower i.val + s.slack) else h

def replaceDigit (v i value : Nat) : Nat := v - digit v i * place i + value * place i

end FiveColour.Packed
